{
  "name": "fourflowos-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "content:upload": "ts-node scripts/content-upload.ts",
    "db:setup": "mysql -u root -p < scripts/setup-database.sql",
    "db:migrate": "npm run content:upload",
    "sanity:dev": "sanity dev",
    "sanity:build": "sanity build",
    "sanity:deploy": "sanity deploy",
    "sanity:migrate": "ts-node scripts/migrate-to-sanity.ts",
    "profile:generate": "ts-node --project tsconfig.scripts.json scripts/generate-profile.ts",
    "profile:resend": "ts-node --project tsconfig.scripts.json scripts/resend-profile.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.76.0",
    "@portabletext/react": "^3.2.1",
    "@react-spring/web": "^10.0.1",
    "@sanity/cli": "^4.5.0",
    "@sanity/client": "^7.8.2",
    "@sanity/image-url": "^1.1.0",
    "@sanity/vision": "^4.5.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@use-gesture/react": "^10.3.1",
    "framer-motion": "^12.23.12",
    "geo-tz": "^8.1.6",
    "jsonrepair": "^3.13.3",
    "natalengine": "^1.0.8",
    "next": "^16.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.9.2",
    "sanity": "^4.5.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "js-yaml": "^4.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.1",
    "typescript": "^5"
  }
}
