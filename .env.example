# FourFlowOS Web — environment variables
# Copy to .env.local for local dev; set the same vars in the Vercel dashboard for deploys.
# NEXT_PUBLIC_* vars are bundled into the browser build — never put secrets in them.
# (NODE_ENV is set automatically by Next.js — do not set it here.)

# ---------------------------------------------------------------------------
# Supabase (database + auth)
# ---------------------------------------------------------------------------
# Browser-safe project URL + anon key. Required. From Supabase dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only project URL + service-role key (bypasses RLS — never NEXT_PUBLIC). Required.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Sanity CMS (content)
# ---------------------------------------------------------------------------
# Project id + dataset. Required. From sanity.io → project settings.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Read token for server-side fetches. From sanity.io → API → Tokens.
SANITY_API_TOKEN=
# Legacy fallback read by src/lib/sanity.ts — exposed to the browser; prefer SANITY_API_TOKEN.
NEXT_PUBLIC_SANITY_API_TOKEN=

# ---------------------------------------------------------------------------
# AI / profile generation
# ---------------------------------------------------------------------------
# Anthropic API key for Flow Profile + LLM routes. Required. From console.anthropic.com.
ANTHROPIC_API_KEY=

# Astrology chart microservice base URL (Timeless Map). Required for chart features.
CHART_SERVICE_URL=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Resend API key for transactional email. Required. From resend.com → API Keys.
RESEND_API_KEY=
# From address. Leave blank to use the Resend test domain (onboarding@resend.dev,
# only delivers to your own email). Set to 'FourFlow <flow@fourflowos.com>' after domain verification.
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Contact form (Web3Forms)
# ---------------------------------------------------------------------------
# Web3Forms access key — server-only, never NEXT_PUBLIC. From web3forms.com.
# New: used by the server-side contact proxy route (replaces the client-embedded key).
WEB3FORMS_KEY=

# ---------------------------------------------------------------------------
# Admin + security
# ---------------------------------------------------------------------------
# Shared secret for admin API routes (x-admin-key header). Required — routes deny all when unset.
# Generate: openssl rand -hex 32
PROFILE_ADMIN_KEY=

# Optional: Upstash Redis (REST) for durable, cross-instance rate limiting.
# Without these, rate limiting falls back to best-effort in-memory (per lambda instance).
# From console.upstash.com → your Redis database → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical site URL used in links/metadata (e.g. https://fourflowos.com). Optional locally.
NEXT_PUBLIC_SITE_URL=
